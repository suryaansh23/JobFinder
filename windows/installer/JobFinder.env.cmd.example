@echo off
REM Example only. Run configure-google-sheets.bat instead of filling refresh tokens by hand.
set "JOBFINDER_TRACKER_SPREADSHEET_ID=YOUR_SPREADSHEET_ID"
set "JOBFINDER_TRACKER_TAB=Automation Queue"
set "JOBFINDER_INTERVENTION_TAB=Interventions"
set "GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_DESKTOP_CLIENT_ID"
set "GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_DESKTOP_CLIENT_SECRET"
set "GOOGLE_REFRESH_TOKEN=GENERATED_BY_SETUP_HELPER"

REM Optional: prefer a non-expiring dedicated service account for the private tracker.
REM Set up via configure-google-service-account.bat; do not commit the key JSON.
REM set "JOBFINDER_SERVICE_ACCOUNT_KEY_FILE=C:\\Users\\user\\AppData\\Roaming\\JobFinder\\secrets\\google-service-account.json"
