# All optional — JobFinder works with none of these set.
# Copy to .env.local and edit if you need to override a default.

# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBED_MODEL=all-minilm

# Per-LLM-call deadline in ms. A wedged model fails instead of hanging forever.
# JOBFINDER_LLM_TIMEOUT_MS=240000

# Set to 0 to disable the persistent in-page toolbar session.
# JOBFINDER_TOOLBAR_KEEPER=1

# Use Postgres/TimescaleDB instead of the default local SQLite.
# TIMESCALE_URL=postgres://user:pass@host:5432/jobfinder

# PORT=3737


